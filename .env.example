VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Frontend: absolute origin of the backend API. Leave unset for local dev /
# web preview (uses same-origin relative `/api` paths). Required for native
# mobile (Capacitor) builds, since the app's WebView is loaded from a
# capacitor://localhost or file:// origin and cannot reach a relative `/api`.
# No trailing slash.
# VITE_API_BASE_URL=https://api.example.com

# Backend: CORS allowlist. Comma-separated list of origins that may call the
# API from a different origin (e.g. a separately-hosted web client or the
# Capacitor mobile shell). Use "*" to allow any origin. Either env name works.
# CORS_ORIGIN=https://moment.example.com,capacitor://localhost,http://localhost
# ALLOWED_ORIGINS=https://moment.example.com
